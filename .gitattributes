* text=auto

# Windows scripts must keep CRLF (cmd.exe and PowerShell 5.1)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.txt text eol=crlf

*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf

*.png binary
*.ico binary
*.exe binary
*.db binary
*.sqlite binary
*.lock text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
