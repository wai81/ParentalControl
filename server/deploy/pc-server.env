# Settings of the parental control server. After a change: sudo systemctl restart pc-server
PC_SERVER_DATA_DIR=/var/lib/pc-server
# 0.0.0.0: reachable from the home network (children's computers connect here).
PC_SERVER_HOST=0.0.0.0
PC_SERVER_PORT=8000
# true when the parent opens the panel only over https (Tailscale Serve, Caddy).
PC_SERVER_SECURE_COOKIES=false
